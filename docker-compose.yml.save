services:
  sqlserver:
    image: mcr.microsoft.com/mssql/server:2022-latest
    container_name: staybnb-sqlserver
    environment:
      ACCEPT_EULA: "Y"
      MSSQL_SA_PASSWORD: "${MSSQL_SA_PASSWORD:-YourStrong!Passw0rd}"
    ports:
      - "1433:1433"
    volumes:
      - staybnb-sqlserver-data:/var/opt/mssql
    restart: unless-stopped

volumes:
  staybnb-sqlserver-data:
X~Xqqq
