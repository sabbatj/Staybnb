@model List<Staybnb.Web.Models.ViewModels.HostManagementRow>

@{
    ViewData["Title"] = "Host Management";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Host Management</h1>
            <p class="text-muted mb-0">
                Manage active hosts and their properties.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Applications"
           class="btn btn-outline-secondary">
            Host Applications
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">
                <h5>No active hosts</h5>
                <p class="text-muted mb-0">
                    There are currently no users with Host access.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Host</th>
                            <th>Email</th>
                            <th>Properties</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                    @foreach (var host in Model)
                    {
                        <tr>
                            <td>
                                <strong>@host.Name</strong>
                            </td>

                            <td>
                                @host.Email
                            </td>

                            <td>
                                <strong>@host.ActivePropertyCount</strong>
                                active
                                <span class="text-muted">
                                    / @host.PropertyCount total
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-success">
                                    Active Host
                                </span>
                            </td>

                            <td class="text-end">
                                <form asp-controller="Admin"
                                      asp-action="RemoveHost"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Remove Host access for @host.Email? Their properties will be deactivated, while bookings and history will be preserved.');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@host.UserId" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Remove Host
                                    </button>

                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>

                </table>
            </div>
        </div>
    }

    <div class="alert alert-warning mt-4">
        <strong>Safe removal:</strong>
        Removing a host does not delete their account, bookings, reviews,
        images, or historical records. Host access is removed and their
        properties are deactivated.
    </div>

</div>
