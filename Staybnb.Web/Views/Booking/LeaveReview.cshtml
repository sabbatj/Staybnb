@model Staybnb.Web.Models.ViewModels.ReviewCreateViewModel
@{
    ViewData["Title"] = "Leave a Review";
    var property = (Staybnb.Web.Models.HostProperty)ViewBag.Property;
}

<h1>Review: @property.Title</h1>
<p class="text-muted mb-4">How was your stay?</p>

<form asp-action="LeaveReview" method="post" class="row g-3" style="max-width:520px;">
    <input type="hidden" asp-for="PropertyId" />
    <input type="hidden" asp-for="BookingId" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="col-12">
        <label asp-for="Rating" class="form-label">Rating (1–5)</label>
        <select asp-for="Rating" class="form-select">
            <option value="5">5 — Excellent</option>
            <option value="4">4 — Great</option>
            <option value="3">3 — Good</option>
            <option value="2">2 — Fair</option>
            <option value="1">1 — Poor</option>
        </select>
    </div>

    <div class="col-12">
        <label asp-for="Comment" class="form-label"></label>
        <textarea asp-for="Comment" class="form-control" rows="4" placeholder="Tell future guests about your stay..."></textarea>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Submit Review</button>
    </div>
</form>
