@model Staybnb.Web.Models.Booking
@{ ViewData["Title"] = "Guest Check-in"; }

<h1>Check-in: @Model.Property?.Title</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.Property?.CheckInProcess != null)
{
    var steps = System.Text.Json.JsonSerializer.Deserialize<List<string>>(Model.Property.CheckInProcess.StepsJson) ?? new();
    <h5>@Model.Property.CheckInProcess.Title</h5>
    <ol>
        @foreach (var s in steps) { <li>@s</li> }
    </ol>

    <form asp-action="SubmitCheckIn" method="post" enctype="multipart/form-data" class="row g-3 mt-3">
        <input type="hidden" name="bookingId" value="@Model.Id" />
        <div class="col-md-4">
            <label class="form-label">Document Type</label>
            <select name="documentType" class="form-select">
                <option value="ID">ID</option>
                <option value="Passport">Passport</option>
            </select>
        </div>
        <div class="col-md-8">
            <label class="form-label">Upload Document</label>
            <input type="file" name="document" class="form-control" accept="image/*,.pdf" />
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-primary">Submit Check-in</button>
        </div>
    </form>
}
else
{
    <p class="text-muted">The host hasn't configured a check-in process for this property yet.</p>
}
