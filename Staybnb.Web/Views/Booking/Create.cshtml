@model Staybnb.Web.Models.ViewModels.BookingCreateViewModel
@{ ViewData["Title"] = "Book Property"; }

<h1>Book: @(((Staybnb.Web.Models.HostProperty)ViewBag.Property).Title)</h1>
<p class="text-muted">R@(((Staybnb.Web.Models.HostProperty)ViewBag.Property).PricePerNight)/night + cleaning + service fee</p>

<form asp-action="Create" method="post" class="row g-3">
    <input type="hidden" asp-for="PropertyId" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="col-md-4">
        <label asp-for="CheckInDate" class="form-label"></label>
        <input asp-for="CheckInDate" class="form-control" type="date" />
    </div>
    <div class="col-md-4">
        <label asp-for="CheckOutDate" class="form-label"></label>
        <input asp-for="CheckOutDate" class="form-control" type="date" />
    </div>
    <div class="col-md-4">
        <label asp-for="NumberOfGuests" class="form-label"></label>
        <input asp-for="NumberOfGuests" class="form-control" type="number" min="1" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Confirm Booking</button>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
