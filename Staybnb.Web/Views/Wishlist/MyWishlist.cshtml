@model List<Staybnb.Web.Models.WishlistItem>
@{ ViewData["Title"] = "My Wishlist"; }

<h1>My Wishlist</h1>

@if (Model.Any())
{
    <div class="row g-4">
    @foreach (var item in Model)
    {
        var p = item.Property!;
        var reviewCount = p.Reviews.Count;
        var avgRating = reviewCount > 0 ? p.Reviews.Average(r => r.Rating) : 0;
        var img = p.Images.FirstOrDefault()?.ImageUrl;

        <div class="col-md-4">
            <div class="property-card h-100">
                <div class="property-card-img">
                    @if (img != null)
                    {
                        <img src="@img" style="width:100%;height:220px;object-fit:cover;" />
                    }
                    <form asp-controller="Wishlist" asp-action="Toggle" method="post" class="wishlist-form">
                        <input type="hidden" name="propertyId" value="@p.Id" />
                        <input type="hidden" name="returnUrl" value="/Wishlist/MyWishlist" />
                        <button class="wishlist-heart wishlist-heart-active" type="submit" title="Remove">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
                        </button>
                    </form>
                </div>
                <div class="p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="card-title mb-1">@p.Title</h5>
                        <div class="rating-pill">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
                            @avgRating.ToString("0.0") <span class="text-muted">(@reviewCount)</span>
                        </div>
                    </div>
                    <p class="text-muted mb-2 small">@p.City, @p.PropertyType</p>
                    <p><span class="price-tag">R@(p.PricePerNight.ToString("N0")) <small>/ night</small></span></p>
                    <a asp-controller="Properties" asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-primary btn-sm mt-2">View</a>
                </div>
            </div>
        </div>
    }
    </div>
}
else
{
    <div class="empty-state">
        <h5>Your wishlist is empty</h5>
        <p class="mb-0">Tap the heart on any property to save it here.</p>
        <a asp-controller="Properties" asp-action="Index" class="btn btn-primary mt-2">Browse stays</a>
    </div>
}
