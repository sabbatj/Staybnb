@using Microsoft.AspNetCore.Identity
@using Staybnb.Web.Models
@using Staybnb.Web.Constants
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staybnb.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Staybnb.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Staybnb.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Properties" asp-action="Index">Browse</a></li>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            if (User.IsInRole(Roles.Guest))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Hosting" asp-action="BecomeHost">Become a Host</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Hosting" asp-action="MyApplications">Host Application Status</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Booking" asp-action="MyBookings">My Bookings</a></li>
                            }
                            if (User.IsInRole(Roles.Host))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Host" asp-action="Dashboard">Host Dashboard</a></li>
                            }
                            if (User.IsInRole(Roles.Admin))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Admin" asp-action="Dashboard">Admin Dashboard</a></li>
                            }
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Messages" asp-action="Inbox">Messages</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Notifications" asp-action="Index">Notifications</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var roles = await UserManager.GetRolesAsync((await UserManager.GetUserAsync(User))!);
                            <li class="nav-item d-flex align-items-center me-3">
                                <span class="text-dark small">Hi, @User.Identity!.Name (@string.Join(", ", roles))</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Register</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Login</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Staybnb.Web - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
