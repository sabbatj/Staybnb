@using Microsoft.AspNetCore.Identity
@using Staybnb.Web.Models
@using Staybnb.Web.Constants
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staybnb</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Staybnb.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">S</span>Staybnb
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" asp-controller="Properties" asp-action="Index">Browse</a></li>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            if (User.IsInRole(Roles.Guest))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Hosting" asp-action="BecomeHost">Become a Host</a></li>
                            }
                            if (User.IsInRole(Roles.Host))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Host" asp-action="Dashboard">Host Dashboard</a></li>
                            }
                            if (User.IsInRole(Roles.Admin))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Dashboard">Admin Dashboard</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Hosts">Manage Hosts</a></li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-1">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var currentUser = await UserManager.GetUserAsync(User);
var roles = currentUser != null
    ? await UserManager.GetRolesAsync(currentUser)
    : new List<string>();
                            <li class="nav-item">
                                <a class="icon-link" asp-controller="Notifications" asp-action="Index" title="Notifications">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="icon-link" asp-controller="Messages" asp-action="Inbox" title="Messages">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
                                </a>
                            </li>
                            <li class="nav-item dropdown ms-2">
                                <button class="user-chip dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @User.Identity!.Name <em>@string.Join(", ", roles)</em>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (User.IsInRole(Roles.Guest))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Hosting" asp-action="MyApplications">Host Application Status</a></li>
                                        <li><a class="dropdown-item" asp-controller="Booking" asp-action="MyBookings">My Bookings</a></li>
                                    }
                                    @if (User.IsInRole(Roles.SuperAdmin))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users">Manage Users</a></li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">Log out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
                            <li class="nav-item"><a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login">Log in</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="py-4">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container-fluid">
            <span>&copy; 2026 Staybnb</span>
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
