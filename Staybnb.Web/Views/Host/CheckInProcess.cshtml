@model Staybnb.Web.Models.ViewModels.CheckInProcessViewModel
@{
    ViewData["Title"] = "Check-in Process";
}

<div class="container py-4">
    <div class="mb-4">
        <h1>Configure Check-in Process</h1>
        <p class="text-muted">
            Define the instructions, rules, and documents guests must provide before check-in.
        </p>
    </div>

    <form asp-action="CheckInProcess" method="post" class="row g-4">
        <input type="hidden" asp-for="PropertyId" />

        <div class="col-12">
            <label asp-for="Title" class="form-label">Check-in process title</label>
            <input asp-for="Title" class="form-control" placeholder="e.g. Guest Check-in Instructions" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="StepsText" class="form-label">Rules &amp; instructions</label>
            <textarea asp-for="StepsText"
                      class="form-control"
                      rows="7"
                      placeholder="Bring your ID&#10;Arrive after 2 PM&#10;No smoking inside the property&#10;Contact the host on arrival"></textarea>
            <div class="form-text">
                Enter one rule or instruction per line.
            </div>
            <span asp-validation-for="StepsText" class="text-danger"></span>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-2">Required documents</h5>
                    <p class="text-muted">
                        Select the documents guests must provide during check-in.
                    </p>

                    <div class="form-check mb-2">
                        <input asp-for="RequireId" class="form-check-input" />
                        <label asp-for="RequireId" class="form-check-label">
                            South African ID
                        </label>
                    </div>

                    <div class="form-check">
                        <input asp-for="RequirePassport" class="form-check-input" />
                        <label asp-for="RequirePassport" class="form-check-label">
                            Passport
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">
                Save Check-in Process
            </button>

            <a asp-action="MyProperties" class="btn btn-outline-secondary ms-2">
                Cancel
            </a>
        </div>
    </form>
</div>
