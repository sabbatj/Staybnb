@model List<Staybnb.Web.Models.GuestCheckIn>
@{ ViewData["Title"] = "Guest Check-Ins"; }

<h1>Guest Check-Ins</h1>

@foreach (var c in Model)
{
    <div class="card mb-3 p-3">
        <p><strong>Property:</strong> @c.Booking?.Property?.Title</p>
        <p><strong>Guest:</strong> @c.Booking?.Guest?.FirstName @c.Booking?.Guest?.LastName</p>

        <p>
            <strong>Status:</strong>
            <span class="badge @(c.Status == Staybnb.Web.Models.CheckInStatus.Verified ? "bg-success" : "bg-warning text-dark")">
                @c.Status
            </span>
        </p>

        <h5>Uploaded Documents</h5>

        @if (c.Documents.Any())
        {
            <div class="list-group">
                @foreach (var doc in c.Documents)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@doc.DocumentType</strong>
                            <br />
                            <small class="text-muted">@doc.FileName</small>
                        </div>

                        <div>
                            <a href="/uploads/documents/@doc.FileName"
                               target="_blank"
                               class="btn btn-sm btn-outline-primary me-2">
                                View document
                            </a>

                            @if (doc.Status != Staybnb.Web.Models.DocumentStatus.Verified)
                            {
                                <form asp-action="VerifyDocument"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="documentId" value="@doc.Id" />
                                    <button type="submit" class="btn btn-sm btn-success">
                                        Verify
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    ✓ Verified
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">No documents uploaded yet.</p>
        }
    </div>
}

@if (!Model.Any())
{
    <p class="text-muted">No guest check-ins yet.</p>
}
