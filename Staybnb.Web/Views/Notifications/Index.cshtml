@model List<Staybnb.Web.Models.Notification>
@{ ViewData["Title"] = "Notifications"; }

<h1>Notifications</h1>

<form asp-action="MarkAllRead" method="post" class="mb-3">
    <button type="submit" class="btn btn-sm btn-outline-secondary">
        Mark all as read
    </button>
</form>

<ul class="list-group">
@foreach (var n in Model)
{
    <li class="list-group-item @(n.IsRead ? "" : "list-group-item-warning")">

        <strong>@n.Title</strong>

        <div>
            @n.Message
        </div>

        <div class="text-muted small">
            @n.CreatedAt.ToString("yyyy-MM-dd HH:mm")
        </div>

        @if (!string.IsNullOrWhiteSpace(n.ActionUrl))
        {
            <a href="@n.ActionUrl" class="btn btn-sm btn-primary mt-2">
                View
            </a>
        }

        @if (!n.IsRead)
        {
            <form asp-action="MarkRead" method="post" class="d-inline">
                <input type="hidden" name="id" value="@n.Id" />

                <button type="submit" class="btn btn-sm btn-link">
                    Mark read
                </button>
            </form>
        }
    </li>
}
</ul>

@if (!Model.Any())
{
    <p class="text-muted">No notifications yet.</p>
}
