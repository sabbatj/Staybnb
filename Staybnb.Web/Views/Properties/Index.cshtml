@model List<Staybnb.Web.Models.HostProperty>
@{ ViewData["Title"] = "Browse Properties"; }

<h1>Find your next stay</h1>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <input type="text" name="city" value="@ViewBag.City" class="form-control" placeholder="City" />
    </div>
    <div class="col-md-4">
        <input type="text" name="propertyType" value="@ViewBag.PropertyType" class="form-control" placeholder="Property type" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<div class="row g-3">
@foreach (var p in Model)
{
    <div class="col-md-4">
        <div class="card h-100">
            @{
                var img = p.Images.FirstOrDefault()?.ImageUrl;
            }
            @if (img != null)
            {
                <img src="@img" class="card-img-top" style="height:200px;object-fit:cover;" />
            }
            <div class="card-body">
                <h5 class="card-title">@p.Title</h5>
                <p class="text-muted mb-1">@p.City, @p.PropertyType</p>
                <p class="fw-bold">R@p.PricePerNight / night</p>
                <a asp-controller="Properties" asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-primary btn-sm">View</a>
            </div>
        </div>
    </div>
}
</div>
@if (!Model.Any())
{
    <p class="text-muted mt-3">No properties found.</p>
}
