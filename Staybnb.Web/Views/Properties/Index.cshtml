@model List<Staybnb.Web.Models.HostProperty>
@{
    ViewData["Title"] = "Browse Properties";
    var wishlistIds = (List<int>)ViewBag.WishlistIds;
    var isSignedIn = User.Identity != null && User.Identity.IsAuthenticated;
}

<h1>Find your next stay</h1>
<p class="text-muted mb-4">Verified listings across South Africa.</p>

<div class="search-panel">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label">City</label>
            <input type="text" name="city" value="@ViewBag.City" class="form-control" placeholder="e.g. Cape Town" />
        </div>
        <div class="col-md-5">
            <label class="form-label">Property type</label>
            <input type="text" name="propertyType" value="@ViewBag.PropertyType" class="form-control" placeholder="e.g. Cabin, Apartment" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Search</button>
        </div>
    </form>
</div>

@if (Model.Any())
{
    <div class="row g-4">
    @foreach (var p in Model)
    {
        var reviewCount = p.Reviews.Count;
        var avgRating = reviewCount > 0 ? p.Reviews.Average(r => r.Rating) : 0;
        var img = p.Images.FirstOrDefault()?.ImageUrl;
        var imgCount = p.Images.Count;
        var isSaved = wishlistIds.Contains(p.Id);

        <div class="col-md-4">
            <div class="property-card h-100">
                <div class="property-card-img">
                    @if (img != null)
                    {
                        <img src="@img" style="width:100%;height:220px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="property-card-noimg">No photo yet</div>
                    }
                    @if (imgCount > 1)
                    {
                        <span class="photo-count-badge">1/@imgCount</span>
                    }
                    @if (isSignedIn)
                    {
                        <form asp-controller="Wishlist" asp-action="Toggle" method="post" class="wishlist-form">
                            <input type="hidden" name="propertyId" value="@p.Id" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button class="wishlist-heart @(isSaved ? "wishlist-heart-active" : "")" type="submit" title="Save">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="@(isSaved ? "currentColor" : "none")" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="wishlist-heart" title="Log in to save">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
                        </a>
                    }
                </div>
                <div class="p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="card-title mb-1">@p.Title</h5>
                        <div class="rating-pill">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
                            @avgRating.ToString("0.0") <span class="text-muted">(@reviewCount)</span>
                        </div>
                    </div>
                    <p class="text-muted mb-2 small">@p.City, @p.PropertyType</p>
                    <p class="text-muted mb-2 small">Up to @p.MaxGuests guests · @p.Bedrooms bed@(p.Bedrooms == 1 ? "" : "s")</p>
                    <p><span class="price-tag">R@(p.PricePerNight.ToString("N0")) <small>/ night</small></span></p>
                    <a asp-controller="Properties" asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-primary btn-sm mt-2">View</a>
                </div>
            </div>
        </div>
    }
    </div>
}
else
{
    <div class="empty-state">
        <h5>No stays found yet</h5>
        <p class="mb-0">Try a different city, or check back soon as new hosts join.</p>
    </div>
}
