@model Staybnb.Web.Models.HostProperty
@{ ViewData["Title"] = Model.Title; }

<h1>@Model.Title</h1>
<p class="text-muted">@Model.Address, @Model.City</p>

<div class="row g-2 mb-3">
@foreach (var img in Model.Images)
{
    <div class="col-md-3"><img src="@img.ImageUrl" class="img-fluid rounded" /></div>
}
</div>

<div class="row">
    <div class="col-md-8">
        <p>@Model.Description</p>
        <ul class="list-inline">
            <li class="list-inline-item">@Model.MaxGuests guests</li>
            <li class="list-inline-item">@Model.Bedrooms bedrooms</li>
            <li class="list-inline-item">@Model.Beds beds</li>
            <li class="list-inline-item">@Model.Bathrooms bathrooms</li>
        </ul>
        <p><strong>Hosted by:</strong> @Model.Host?.FirstName @Model.Host?.LastName</p>

        @if (User.Identity != null && User.Identity.IsAuthenticated && Model.HostId != null)
        {
            <form asp-controller="Messages" asp-action="Send" method="post" class="mt-3">
                <input type="hidden" name="ReceiverId" value="@Model.HostId" />
                <div class="mb-2">
                    <textarea name="Content" class="form-control" rows="2" placeholder="Ask the host a question..."></textarea>
                </div>
                <button type="submit" class="btn btn-outline-secondary btn-sm">Send Message</button>
            </form>
        }
    </div>
    <div class="col-md-4">
        <div class="card p-3">
            <h4>R@Model.PricePerNight <small class="text-muted">/ night</small></h4>
            <p class="text-muted">+ R@Model.CleaningFee cleaning, R@Model.ServiceFee service</p>
            @if (User.IsInRole(Staybnb.Web.Constants.Roles.Guest))
            {
                <a asp-controller="Booking" asp-action="Create" asp-route-propertyId="@Model.Id" class="btn btn-primary">Book now</a>
            }
            else if (User.Identity == null || !User.Identity.IsAuthenticated)
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Log in to book</a>
            }
        </div>
    </div>
</div>
